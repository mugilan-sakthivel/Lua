# Luna Website Builder - Environment Variables

# Google Gemini API Key (for LLM and embeddings)
GOOGLE_API_KEY=your_google_api_key_here

# Supabase PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example: postgresql://postgres:password@localhost:5432/luna_db
DATABASE_URL=postgresql://user:password@host:port/database

# Langfuse Configuration (optional, for tracing)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key_here

# Vector Store Configuration
VECTOR_STORE_TYPE=supabase  # Using Supabase for vector storage
EMBEDDING_MODEL=models/gemini-embedding-001  # Gemini embedding model

# Project Configuration
PROJECT_NAME=Luna Website Builder
LOG_LEVEL=INFO
