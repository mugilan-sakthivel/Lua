// Prisma schema for website sections with vector embeddings

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WebsiteSection {
  id               BigInt  @id @default(autoincrement())
  section_type     String  @db.Text
  website_name     String  @db.Text
  website_url      String  @db.Text
  theme            String  @db.Text
  code             String  @db.Text
  description      String  @db.Text
  font_url         String? @db.Text
  document         String? @db.Text
  document_vectors Unsupported("vector(1536)")

  @@map("website_sections")
}